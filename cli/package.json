{
  "name": "@lynn/cli",
  "version": "0.86.4",
  "private": false,
  "type": "module",
  "description": "Lynn command line interface and worker runner",
  "license": "Apache-2.0",
  "bin": {
    "Lynn": "./bin/lynn.mjs"
  },
  "files": [
    "bin/",
    "scripts/preinstall.mjs",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "preinstall": "node scripts/preinstall.mjs",
    "prepack": "npm run build",
    "stress:cli": "npm run build && node scripts/stress-cli.mjs",
    "test": "vitest run tests --reporter=dot",
    "test:fleet": "vitest run tests/code-tools.test.ts tests/code-agent-loop*.test.ts tests/worker-run*.test.ts tests/providers.test.ts tests/brain-render.test.ts tests/status-bar.test.ts tests/vision*.test.ts --reporter=dot",
    "test:voice": "vitest run tests/voice.test.ts --reporter=dot",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ink": "6.4.0",
    "react": "19.2.6"
  }
}
